{
  "name": "@petpal/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PetPal web client — instant, veterinary-sourced answers to 'can my pet eat this?'",
  "keywords": [
    "pet-food-safety",
    "pet-care",
    "react",
    "typescript",
    "vite",
    "tailwindcss",
    "pet-nutrition",
    "food-toxicity"
  ],
  "author": "Sunayana225",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "framer-motion": "^14.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.11.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
