{
  "name": "@petpal/backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "start:prod": "node ../../scripts/run-production.cjs dist/index.js",
    "dev": "node --watch -r ts-node/register src/index.ts",
    "build": "tsc",
    "build:prod": "node ../../scripts/run-production.cjs ../../node_modules/typescript/bin/tsc",
    "clean": "node ../../scripts/clean-backend.cjs",
    "prebuild": "npm run clean",
    "postbuild": "echo Build completed successfully",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "start:local": "npm run build && npm start",
    "deploy": "npm run build:prod && npm run start:prod",
    "sync:recalls": "ts-node src/scripts/syncRecallSources.ts"
  },
  "keywords": [
    "pet-food-safety",
    "food-toxicity",
    "veterinary",
    "express-api",
    "typescript"
  ],
  "author": "Sunayana225",
  "license": "MIT",
  "description": "AI-powered tool to check if food is safe for pets. Uses veterinary data + Gemini fallback. Works for 10 pet types. Backend API (Express + TypeScript).",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/supertest": "^6.0.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "jest": "^30.0.4",
    "postcss": "^8.5.6",
    "supertest": "^7.1.3",
    "tailwindcss": "^4.1.11",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0"
  }
}
