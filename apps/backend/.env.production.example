# Set these in the hosting service, or copy to root .env.production for Docker Compose.
# Node does not automatically load .env.production; Compose passes this file to the container.
NODE_ENV=production
PORT=3001
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
WEB_APP_URL=https://app.your-domain.example
OAUTH_CALLBACK_BASE=https://api.your-domain.example
CORS_ORIGIN=https://app.your-domain.example
SESSION_COOKIE_SAMESITE=lax
# Durable volume path. Never place this database on ephemeral or network storage.
DB_PATH=/var/lib/petpal/petpal.db
AI_CACHE_SERVE_UNREVIEWED=false
# Configure at least one OAuth provider before enabling accounts.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional AI draft generation; public answers remain review-gated.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ADMIN_TOKEN=
ADMIN_EMAILS=
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
DEFAULT_KEY_QUOTA=1000
DEFAULT_KEY_WINDOW=day
ACCOUNT_DAILY_QUOTA=10000
