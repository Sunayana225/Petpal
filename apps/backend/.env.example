# Gemini API Configuration (Primary AI Service)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Model name (optional). Defaults to gemini-3.8-flash, and falls back to
# gemini-2.5-flash automatically if the primary is unavailable for your key.
# GEMINI_MODEL=gemini-3.8-flash

# OpenAI (reserved — nothing implements this yet; safe to leave blank)
# OPENAI_API_KEY=

# Server Configuration
PORT=3001
NODE_ENV=development

# Production Configuration
# Set NODE_ENV=production for production deployment
# CORS_ORIGIN=https://your-frontend-domain.com
# API_BASE_URL=https://your-api-domain.com

# Security Configuration
# Generate a secure random string for JWT if implementing auth later
# JWT_SECRET=your_jwt_secret_here

# Admin token for the AI review queue. Without it, /api/admin/* refuses every
# request. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_TOKEN=your_random_admin_token_here

# --- Developer platform (auth + API keys) ------------------------------------
# Signing secret for session cookies. Required in production.
# SESSION_SECRET=your_random_session_secret
# SameSite for the sign-in cookie. Leave unset for a same-site deploy (defaults
# to `lax`). Set `none` when the web app and this API are on *different* sites
# (e.g. web on *.vercel.app, API on *.onrender.com) — it also requires
# CORS_ORIGIN to name the web origin, and HTTPS, because a SameSite=None cookie
# must be Secure.
# SESSION_COOKIE_SAMESITE=none
# Optional: pin the cookie to a parent domain, e.g. .example.com
# SESSION_COOKIE_DOMAIN=.example.com
# Public base URL of this API, used to build OAuth callback URLs.
OAUTH_CALLBACK_BASE=http://localhost:3001
# Where the browser is sent after signing in.
WEB_APP_URL=http://localhost:3000
# OAuth apps (register your own — see README for callback URLs).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails promoted to admin on first login.
ADMIN_EMAILS=
# Development-only shortcut sign-in (POST /api/auth/dev-login). It is already
# allowed outside production; set DEV_AUTH=1 to enable it in production too.
# DEV_AUTH=1
# SQLite file (defaults to data/petpal.db).
DB_PATH=
# Default quota for a newly created API key.
DEFAULT_KEY_QUOTA=1000
DEFAULT_KEY_WINDOW=day
# Durable AI-answer cache.
AI_ANSWER_TTL_HOURS=168
AI_CACHE_SERVE_UNREVIEWED=true

# Database Configuration (if you add a database later)
# DATABASE_URL=your_database_connection_string

# External API Configuration
# OPEN_PET_FOOD_FACTS_API=https://world.openpetfoodfacts.org
# DOG_FOOD_API_KEY=your_dog_food_api_key_if_available

# Logging Configuration
LOG_LEVEL=info
# SENTRY_DSN=your_sentry_dsn_for_error_tracking
