{
  "name": "petpal-backend",
  "version": "1.0.0",
  "main": "../apps/backend/dist/index.js",
  "scripts": {
    "postinstall": "npm --prefix .. ci",
    "start": "node ../apps/backend/dist/index.js",
    "start:prod": "node ../scripts/run-production.cjs ../apps/backend/dist/index.js",
    "dev": "npm --prefix .. run dev:api",
    "build": "npm --prefix .. run build --workspace @petpal/backend",
    "build:prod": "npm --prefix .. run build:prod --workspace @petpal/backend",
    "clean": "node ../scripts/clean-backend.cjs",
    "test": "npm --prefix .. run test --workspace @petpal/backend",
    "test:ci": "npm --prefix .. run test:ci --workspace @petpal/backend",
    "lint": "npm --prefix .. run lint --workspace @petpal/backend",
    "typecheck": "npm --prefix .. run typecheck --workspace @petpal/backend",
    "deploy": "npm run build:prod && npm run start:prod"
  },
  "keywords": [
    "pet-food-safety",
    "veterinary-database",
    "pet-nutrition",
    "food-toxicity",
    "animal-health",
    "pet-care",
    "ai-powered",
    "express-api",
    "typescript",
    "multi-pet-support",
    "dogs",
    "cats",
    "rabbits",
    "hamsters",
    "birds",
    "turtles",
    "fish",
    "lizards",
    "snakes",
    "open-source",
    "veterinary",
    "vet",
    "toxicity",
    "poisoning-prevention",
    "pet-health",
    "gemini-ai",
    "food-safety"
  ],
  "author": "Sunayana225",
  "license": "MIT",
  "description": "Compatibility launcher for the maintained @petpal/backend workspace",
  "dependencies": {},
  "devDependencies": {},
  "private": true
}
