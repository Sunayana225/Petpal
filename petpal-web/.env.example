# Base URL of the PetPal API.
# Leave unset to use the same origin (`/api`), which works with the built-in
# Vite dev proxy during development and with any same-origin deployment.
# Set it when the API is hosted elsewhere, e.g.:
VITE_API_URL=https://petpalapi.onrender.com/api

# --- Analytics (optional, cookieless) ----------------------------------------
# Leave all of these unset to ship with zero third-party scripts.
# Set ONE provider. Plausible:
# VITE_PLAUSIBLE_DOMAIN=petpal.example.com
# Or Umami (cloud or self-hosted):
# VITE_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
# VITE_UMAMI_SRC=https://analytics.example.com/script.js

