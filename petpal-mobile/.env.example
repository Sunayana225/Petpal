# Base URL of the PetPal API.
#
# A physical device cannot reach your computer's localhost, so point this at
# your machine's LAN address (e.g. http://192.168.1.20:3001/api) or the deployed
# host when testing on hardware. Guards against a trailing slash are handled in
# src/api.ts.
EXPO_PUBLIC_API_URL=http://localhost:3001/api
